	partition F_Credit_Echeances_Futures = m
		mode: import
		source =
				let
					Source = Sql.Database(pServeur, pBaseReporting, [CreateNavigationProperties=false, CommandTimeout=#duration(0, 0, 10, 0)]),
					TableSource = Source{[Schema="rpt", Item="f_credit_echeances_futures"]}[Data],
					MoisDebut = Date.StartOfMonth(Date.AddDays(pDateFin, 1)),
					MoisFin = Date.StartOfMonth(Date.AddYears(pDateFin, 1)),
					FiltrePeriode = Table.SelectRows(TableSource, each [mois_echeance] >= MoisDebut and [mois_echeance] <= MoisFin),
					ColonnesModele = Table.SelectColumns(FiltrePeriode, {
						"mois_echeance", "code_agence", "agence", "produit_credit", "devise",
						"prets_concernes", "echeances", "capital_attendu", "interet_attendu",
						"commission_attendue", "epargne_attendue", "total_attendu"
					}),
					Resultat = Table.RenameColumns(ColonnesModele, {
						{"code_agence", "code_agence_demande"},
						{"agence", "nom_agence_demande"},
						{"produit_credit", "produit"},
						{"devise", "code_devise"},
						{"prets_concernes", "nb_prets_concernes"},
						{"echeances", "nb_echeances"}
					})
				in
					Resultat

	annotation RequetePerfectVision = 100

	annotation SourceLocale = BB_VISION_REPORTING

	annotation SourceReportingObject = rpt.f_credit_echeances_futures

