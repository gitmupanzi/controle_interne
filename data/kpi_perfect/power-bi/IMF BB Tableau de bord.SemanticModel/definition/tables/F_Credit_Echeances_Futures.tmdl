/// Échéances de crédit futures regroupées par mois, produit et devise.
table F_Credit_Echeances_Futures
	lineageTag: 7847ef1b-2f13-4720-ae77-d5074601e680

	column 'Mois échéance'
		dataType: dateTime
		formatString: Long Date
		lineageTag: aa501cee-0097-41a2-b267-af46b2ea0f15
