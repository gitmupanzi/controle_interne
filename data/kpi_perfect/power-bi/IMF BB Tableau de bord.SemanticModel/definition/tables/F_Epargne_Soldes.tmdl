/// Soldes d'épargne et nombre de comptes par mois, agence, produit et devise.
table F_Epargne_Soldes
	lineageTag: 4779fc61-c5b2-44a0-ad1f-132808d1778e

	column 'Date situation'
		dataType: dateTime
		lineageTag: 0ec07486-4f08-4d5a-ba43-04d5cc9048d6
		summarizeBy: none
		sourceColumn: date_situation

	column Mois
		dataType: dateTime
		lineageTag: f8d63486-20ba-4c02-80ba-25fb8a9d8b1a
		summarizeBy: none
		sourceColumn: mois

	column 'Code agence'
		dataType: string
		lineageTag: da1b51c9-e439-42da-b8b9-2d888c65ceee
		summarizeBy: none
		sourceColumn: code_agence_compte

	column Agence
		dataType: string
		lineageTag: 99476c46-5233-4e25-895a-21a8164f30c7
		summarizeBy: none
		sourceColumn: nom_agence_compte

	column 'Produit épargne'
		dataType: string
		lineageTag: 30057528-df53-44fb-9f3c-6053ecf70f45
		summarizeBy: none
		sourceColumn: produit_epargne

	column 'Type compte'
		dataType: string
		lineageTag: e4f63f4e-08ed-4d35-a6f7-5c1ed20ae767
		summarizeBy: none
		sourceColumn: type_compte_adherent

	column Devise
		dataType: string
		lineageTag: d4881c9d-db50-43b8-908c-126a14ba5b2e
		summarizeBy: none
		sourceColumn: code_devise

	column Comptes
		dataType: int64
		lineageTag: ad4e88cc-3f8b-4cdb-81e5-da499e135b6e
		summarizeBy: none
		sourceColumn: nb_comptes

	column Clients
		dataType: int64
		lineageTag: ab29177c-8395-4573-b9dd-eb447cf48021
		summarizeBy: none
		sourceColumn: nb_clients

	column 'Solde épargne'
		dataType: double
		lineageTag: 2410e4fe-c5ac-45ba-ada0-0a7d27640615
		summarizeBy: none
		sourceColumn: solde_epargne

	column 'Solde moyen compte'
		dataType: double
		lineageTag: 52dc5336-fcb1-46c2-8973-e5c3d1a5a437
		summarizeBy: none
		sourceColumn: solde_moyen_compte

	partition F_Epargne_Soldes = m
		mode: import
		source =
				let
					Source = Sql.Database(pServeur, pBaseDonnees, [CreateNavigationProperties=false, CommandTimeout=#duration(0, 0, 10, 0)]),
					SqlTexte = Text.Combine({
					"SET NOCOUNT ON;",
					"DECLARE @date_debut date = '" & Date.ToText(pDateDebut, [Format="yyyy-MM-dd", Culture="en-US"]) & "';",
					"DECLARE @date_fin date = '" & Date.ToText(pDateFin, [Format="yyyy-MM-dd", Culture="en-US"]) & "';",
					"WITH mouvements_comptables AS (",
					"SELECT ID as ID, DATE_OPERATION, DESCRIPTION, ID_OPERATION, LETTRE, MONTANT_OPERATION,",
					"        NUM_TRANSACTION, NUMERO_RECU, RAPPROCHEMENT, SENS, VENTILATION, NUM_MOUVEMENT,",
					"        ID_COMPTE, ID_DEVISE, ID_JOURNAL, ID_POINT_SERVICE, ID_TYPE_OPERATION, DATE_SAISIE,",
					"        DATE_VALEUR, NUM_LIGNE, MONTANT_REEL, REFERENCE_TIERS, ID_TIER",
					"FROM hdpm",
					"",
					"UNION",
					"",
					"SELECT CODE as ID, DATE_OPERATION, DESCRIPTION, ID_OPERATION, LETTRE, MONTANT_OPERATION,",
					"        NUM_TRANSACTION, NUMERO_RECU, RAPPROCHEMENT, SENS, VENTILATION, NUM_MOUVEMENT,",
					"        ID_COMPTE, ID_DEVISE, ID_JOURNAL, ID_POINT_SERVICE, ID_TYPE_OPERATION, DATE_SAISIE,",
					"        DATE_OPERATION as DATE_VALEUR, ID as NUM_LIGNE, MONTANT_OPERATION as MONTANT_REEL,",
					"        NULL as REFERENCE_TIERS, NULL as ID_TIER",
					"FROM hdpm_api",
					"),",
					"mois AS (",
					"  SELECT",
					"    EOMONTH(CAST(@date_debut AS DATE)) AS date_situation",
					"  UNION ALL",
					"  SELECT",
					"    EOMONTH(CAST(DATEADD(MONTH, 1, date_situation) AS DATE))",
					"  FROM mois",
					"  WHERE",
					"    EOMONTH(CAST(DATEADD(MONTH, 1, date_situation) AS DATE)) <= EOMONTH(CAST(@date_fin AS DATE))",
					"), comptes_epargne AS (",
					"  SELECT",
					"    c.ID AS id_compte,",
					"    c.NUM_CPTE AS NUM_CPTE,",
					"    c.LIBELLE AS libelle_compte,",
					"    c.DATE_OUVERTURE AS DATE_OUVERTURE,",
					"    c.ID_POINT_SERVICE AS id_agence_compte,",
					"    ps.CODE AS code_agence_compte,",
					"    ps.NOM AS nom_agence_compte,",
					"    ca.ID_ADHERENT AS id_client,",
					"    ca.TYPE_CPTE_ADH AS type_compte_adherent,",
					"    dv.CODE AS code_devise,",
					"    pe.ID AS id_produit_epargne,",
					"    ISNULL(pe.LIBELLE, c.LIBELLE) AS produit_epargne",
					"  FROM dbo.COMPTES AS c",
					"  INNER JOIN dbo.COMPTES_ADHERENT AS ca",
					"    ON ca.id = c.ID",
					"  LEFT JOIN dbo.COMPTES_ADHERENT_INFO AS cai",
					"    ON cai.id = c.ID",
					"  LEFT JOIN dbo.PRODUITS_EPG AS pe",
					"    ON pe.ID = cai.ID_PRODUIT_EPG",
					"  LEFT JOIN dbo.DEVISES AS dv",
					"    ON dv.ID = c.ID_DEVISE",
					"  LEFT JOIN dbo.POINTS_SERVICE AS ps",
					"    ON ps.ID = c.ID_POINT_SERVICE",
					"  WHERE",
					"    ca.TYPE_CPTE_ADH IN ('CAU', 'DAT', 'PLN', 'DAV', 'TNT')",
					"), soldes_mensuels AS (",
					"  SELECT",
					"    m.date_situation AS date_situation,",
					"    ce.id_compte AS id_compte,",
					"    SUM(CASE WHEN h.SENS = 'D' THEN -1 ELSE 1 END * ISNULL(h.MONTANT_OPERATION, 0)) AS solde_compte",
					"  FROM mois AS m",
					"  INNER JOIN comptes_epargne AS ce",
					"    ON ce.DATE_OUVERTURE <= m.date_situation",
					"  LEFT JOIN mouvements_comptables AS h",
					"    ON h.ID_COMPTE = ce.id_compte AND h.DATE_OPERATION <= m.date_situation",
					"  WHERE",
					"    NOT EXISTS(",
					"      SELECT",
					"        1",
					"      FROM dbo.CLOTURE_COMPTE AS cc",
					"      WHERE",
					"        cc.ID_COMPTE = ce.id_compte AND cc.DATE_CLOTURE <= m.date_situation",
					"    )",
					"  GROUP BY",
					"    m.date_situation,",
					"    ce.id_compte",
					")",
					"SELECT",
					"  sm.date_situation,",
					"  DATEFROMPARTS(YEAR(sm.date_situation), MONTH(sm.date_situation), 1) AS mois,",
					"  ce.code_agence_compte,",
					"  ce.nom_agence_compte,",
					"  ce.produit_epargne,",
					"  ce.type_compte_adherent,",
					"  ce.code_devise,",
					"  COUNT(DISTINCT ce.id_compte) AS nb_comptes,",
					"  COUNT(DISTINCT ce.id_client) AS nb_clients,",
					"  SUM(ISNULL(sm.solde_compte, 0)) AS solde_epargne,",
					"  CASE",
					"    WHEN COUNT(DISTINCT ce.id_compte) = 0",
					"    THEN 0",
					"    ELSE ROUND(SUM(ISNULL(sm.solde_compte, 0)) / COUNT(DISTINCT ce.id_compte), 2)",
					"  END AS solde_moyen_compte",
					"FROM soldes_mensuels AS sm",
					"INNER JOIN comptes_epargne AS ce",
					"  ON ce.id_compte = sm.id_compte",
					"GROUP BY",
					"  sm.date_situation,",
					"  DATEFROMPARTS(YEAR(sm.date_situation), MONTH(sm.date_situation), 1),",
					"  ce.id_agence_compte,",
					"  ce.code_agence_compte,",
					"  ce.nom_agence_compte,",
					"  ce.id_produit_epargne,",
					"  ce.produit_epargne,",
					"  ce.type_compte_adherent,",
					"  ce.code_devise",
					"ORDER BY",
					"  sm.date_situation,",
					"  ce.nom_agence_compte,",
					"  ce.produit_epargne OPTION(",
					"    MAXRECURSION 0",
					");"
					}, "#(lf)"),
					Resultat = Value.NativeQuery(Source, SqlTexte, null, [EnableFolding=false])
				in
					Resultat

	annotation RequetePerfectVision = 103

	annotation SourceLocale = BB_VISION_PRO_TEST

