		formatString: #,##0
		lineageTag: 18803aa4-4820-4d4a-96af-db220086bf1c

	/// Nombre de lignes de contrôle qualité présentes dans le socle unique.
	measure 'Contrôles qualité' = COALESCE(CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Type élément] = "Controle qualite")), 0)
		formatString: #,##0
		lineageTag: 5a737e24-5c71-49d2-bb6b-d105cd5b408d

	/// Somme du champ Nombre de la requête 156 ; à lire dans le grain et la rubrique affichés.
	measure 'Nombre déclaré' = SUM(F_Conformite[Nombre])
		formatString: #,##0
		lineageTag: 0e9227ba-958c-4b9f-9c4c-b2900aa55ce6

	/// Nombre de lignes du socle unique de conformité dans le contexte de filtre actif.
	measure 'Lignes 156' = COUNTROWS(F_Conformite)
		formatString: #,##0
		lineageTag: dd361ab5-8e0f-4ff7-a1b6-4810beb525ef

	/// Nombre de lignes ayant un niveau de sévérité renseigné.
	measure 'Lignes sévérité' = CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(NOT ISBLANK(F_Conformite[Sévérité])))
		formatString: #,##0
		lineageTag: 42990448-05ce-4856-bada-9a8f3baf13b6

	/// Nombre d'analyses de conformité distinctes présentes dans le socle unique.
	measure 'Analyses LBC-FT' = DISTINCTCOUNT(F_Conformite[Analyse])
		formatString: #,##0
		lineageTag: becb585e-3aa8-473c-9104-9bc7651a5795

	/// Nombre de lignes de type alerte dans le socle unique.
	measure Alertes = COALESCE(CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Type élément] = "Alerte")), 0)
		formatString: #,##0
		lineageTag: 75f8287b-0787-4824-92bb-dc681e9ee0f4

	/// Nombre de déclarations de soupçon ou CENTIF présentes dans le socle unique.
	measure CENTIF = COALESCE(CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Type élément] = "Declaration")), 0)
		formatString: #,##0
		lineageTag: d6247abf-eff3-4ba0-9959-74e17d4fc17f

	/// Nombre de profils de risque présents dans le socle unique.
	measure 'Profils risque' = COALESCE(CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Type élément] = "Profil de risque")), 0)
		formatString: #,##0
		lineageTag: 273f7a58-f1e6-46e8-a89c-06f5a9370f3e

	/// Nombre de réactivations de comptes dormants présentes dans le socle unique.
	measure Réactivations = COALESCE(CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Type élément] = "Reactivation de compte")), 0)
		formatString: #,##0
		lineageTag: eba62b7b-f484-4b4f-8f78-997ebb280ae4

	/// Nombre de lignes de couverture au statut NON_COUVERT.
	measure 'Non couverts' = COALESCE(CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Statut couverture] = "NON_COUVERT")), 0)
		formatString: #,##0
		lineageTag: 6c978d74-9069-4cd3-a3b0-ddb2846ead9e

	/// Nombre de lignes de couverture au statut PARTIEL.
	measure Partiels = COALESCE(CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Statut couverture] = "PARTIEL")), 0)
		formatString: #,##0
		lineageTag: c5ebeffd-b604-4d18-b020-2642d181a986

	/// Nombre de lignes de couverture au statut COUVERT.
	measure Couverts = COALESCE(CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Statut couverture] = "COUVERT")), 0)
		formatString: #,##0
		lineageTag: 467a27db-ba54-446f-90ea-f068b0bf1798

	/// Nombre de lignes de conformité classées CRITIQUE.
	measure Critiques = COALESCE(CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Sévérité] = "CRITIQUE")), 0)
		formatString: #,##0
		lineageTag: 282fb1e6-13af-4da9-8a40-0e51f7d3aa71

	/// Nombre de lignes actionnables de surveillance : alertes, déclarations, profils de risque, réactivations, fractionnements et gros mouvements.
	measure 'Lignes surveillance' = CALCULATE(COUNTROWS(F_Conformite), KEEPFILTERS(F_Conformite[Type élément] IN {"Alerte", "Declaration", "Profil de risque", "Reactivation de compte", "Fractionnement", "Gros mouvement agrege"}))
		formatString: #,##0
		lineageTag: 5e709e54-85f0-4b12-9483-61b663220ece

	/// Nombre de cas actionnables de surveillance dans le contexte de filtre actif.
	measure 'Cas surveillance' = COALESCE([Lignes surveillance], 0)
		formatString: #,##0
		lineageTag: e636cb6f-7ca2-41b7-bf46-447870f40837

	/// Nombre de cas de surveillance ayant le statut A_REVOIR.
	measure 'Dossiers à revoir' = COALESCE(CALCULATE([Lignes surveillance], KEEPFILTERS(F_Conformite[Statut revue] = "A_REVOIR")), 0)
		formatString: #,##0
		lineageTag: 064fa351-f7ed-4d33-996b-48c0596fe64a

	/// Nombre de clients distincts rattachés aux cas actionnables de surveillance.
	measure 'Clients surveillés' = COALESCE(CALCULATE(DISTINCTCOUNT(F_Conformite[Code client]), KEEPFILTERS(F_Conformite[Type élément] IN {"Alerte", "Declaration", "Profil de risque", "Reactivation de compte", "Fractionnement", "Gros mouvement agrege"}), KEEPFILTERS(NOT ISBLANK(F_Conformite[Code client]))), 0)
		formatString: #,##0
		lineageTag: 3b0aa919-b8ec-445a-a32f-cdd0a469bb68

	/// Nombre de cas actionnables de surveillance ayant une sévérité renseignée.
	measure 'Lignes surveillance sévérité' = CALCULATE([Lignes surveillance], KEEPFILTERS(NOT ISBLANK(F_Conformite[Sévérité])))
		formatString: #,##0
		lineageTag: 028a1c26-5b8b-4d21-a063-a382af39dd50

	/// Nombre de clients distincts dans le socle client-devise.
	measure Clients = DISTINCTCOUNT(F_Clients[Code client])
		formatString: #,##0
		lineageTag: c4d33a1f-8b77-4ec2-8271-a01e9e0cd717

	/// Nombre de clients distincts répondant à la définition opérationnelle d'un client actif.
	measure 'Clients actifs' = CALCULATE(DISTINCTCOUNT(F_Clients[Code client]), KEEPFILTERS(F_Clients[Client actif] = TRUE()))
		formatString: #,##0
		lineageTag: 4e9e08b5-b2e2-443c-b751-8783728cc440

	/// Nombre de clients distincts ayant au moins un compte ouvert.
	measure 'Clients comptes ouverts' = CALCULATE(DISTINCTCOUNT(F_Clients[Code client]), KEEPFILTERS(F_Clients[Avec compte ouvert] = TRUE()))
		formatString: #,##0
		lineageTag: 245d5d32-37e1-4c4a-b5c7-4b2c15a405e9

	/// Nombre de clients distincts ayant au moins un compte explicitement codé bloqué ou gelé.
	measure 'Clients comptes bloqués' = CALCULATE(DISTINCTCOUNT(F_Clients[Code client]), KEEPFILTERS(F_Clients[Avec compte bloqué] = TRUE()))
		formatString: #,##0
		lineageTag: c4d3abb2-0506-447d-8caa-6d09984a73cd

	/// Nombre de clients distincts ayant au moins un compte ouvert sans mouvement depuis 24 mois.
	measure 'Clients comptes dormants' = CALCULATE(DISTINCTCOUNT(F_Clients[Code client]), KEEPFILTERS(F_Clients[Avec compte dormant] = TRUE()))
		formatString: #,##0
		lineageTag: e51e653d-32d0-434a-a3ac-272eb2b8a9c1

	/// Nombre de clients distincts ayant une échéance de crédit dans la période.
	measure 'Clients crédit à rembourser' = CALCULATE(DISTINCTCOUNT(F_Clients[Code client]), KEEPFILTERS(F_Clients[Avec crédit à rembourser] = TRUE()))
		formatString: #,##0
		lineageTag: e5c6eee0-cc3c-43d5-9df6-eedca0cfb4da

	/// Nombre de clients distincts ayant reçu un intérêt d'épargne ou de DAT pendant la période.
	measure 'Clients intérêt épargne' = CALCULATE(DISTINCTCOUNT(F_Clients[Code client]), KEEPFILTERS(F_Clients[Bénéficiaire intérêt épargne] = TRUE()))
		formatString: #,##0
		lineageTag: d25e9572-992a-4313-a916-55e1ca1a74ea

	/// Nombre de clients distincts dont un DAT arrive à échéance dans la période.
	measure 'Clients DAT à échéance' = CALCULATE(DISTINCTCOUNT(F_Clients[Code client]), KEEPFILTERS(F_Clients[Avec DAT à échéance] = TRUE()))
		formatString: #,##0
		lineageTag: b0946f71-bf73-4260-a6b1-9a48b9ea2ace

	/// Montant total des échéances de crédit prévues dans la période.
	measure 'Montant crédit à rembourser' = SUM(F_Clients[Montant crédit à rembourser])
		formatString: #,##0.00
		lineageTag: bd533855-c96a-46bc-89fb-e30f9542acc2

	/// Montant initial des DAT arrivant à échéance dans la période.
	measure 'Montant DAT à échéance' = SUM(F_Clients[Montant DAT à échéance])
		formatString: #,##0.00
		lineageTag: f8cf58f6-2fca-4047-b858-7fbba53d1c06

	/// Nombre de clients distincts présents dans le détail du portefeuille à risque.
	measure 'Clients PAR' = DISTINCTCOUNT(F_Credit_PAR_Detail[Code client])
		formatString: #,##0
		lineageTag: 370ac181-ceca-4dcc-a617-a82430a4262b

	/// Montant total des arriérés du détail PAR.
	measure 'Arriéré crédit' = SUM(F_Credit_PAR_Detail[Arriéré])
		formatString: #,##0.00
		lineageTag: 4fbd2d90-9321-4766-868d-9f7a4678db28

	/// Exposition de crédit non couverte après épargne, caution et garantie.
	measure 'Exposition nette' = SUM(F_Credit_Couverture[Exposition nette])
		formatString: #,##0.00
		lineageTag: 742808dc-ad10-42b1-beaf-89252fcf5786

	/// Part de l'encours portée par les dix pour cent de prêts les plus importants.
	measure 'Part encours top 10%' = DIVIDE(SUM(F_Credit_Concentration[Encours top 10%]), SUM(F_Credit_Concentration[Encours]))
		formatString: 0.00%
		lineageTag: 937e9f8c-fd52-4686-b2b7-06ca73fa14e9

	/// Montant total attendu sur les échéances futures.
	measure 'Échéances futures' = CALCULATE(SUM(F_Credit_Echeances_Futures[Total attendu]), REMOVEFILTERS(D_Date))
		formatString: #,##0.00
		lineageTag: 54656675-e82d-4cef-9302-7b45a053d2e2

	/// Clients renouvelés divisés par les clients arrivés à échéance.
	measure 'Taux rétention crédit' = DIVIDE(SUM(F_Credit_Retention[Clients renouvelés]), SUM(F_Credit_Retention[Clients arrivés échéance]))
		formatString: 0.00%
		lineageTag: d6005237-2fdf-440b-8f17-cd03ef46b4f2

	/// Somme des provisions du détail sur les trois derniers mois.
	measure 'Provision détaillée' = SUM(F_Credit_Provisions_Detail[Provision])
