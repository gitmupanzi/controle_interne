/// Mesures de pilotage. Les montants CDF et USD restent toujours séparés.
table _Mesures
	lineageTag: 74bfb459-2ee8-4e61-af13-2768c78ac72f

	/// Nombre de prêts actifs à la date de situation.
	measure 'Prêts actifs' = SUM(F_Credit_Portefeuille[Prêts actifs])
		formatString: #,##0
		lineageTag: 6d99b154-e198-4c06-a257-d839cf970518

	/// Encours du portefeuille exprimé uniquement en CDF.
	measure 'Encours CDF' = CALCULATE(SUM(F_Credit_Portefeuille[Encours]), KEEPFILTERS(D_Devise[Devise] = "CDF"))
