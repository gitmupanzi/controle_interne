	/// Nombre moyen d'échéances restantes sur les prêts actifs.
	measure 'Échéances restantes moyennes' = AVERAGE(F_Credit_Duree[Échéances restantes])
		formatString: 0.0
		lineageTag: c07d6f8f-9ac9-4e43-a3c6-75126b3d8242

	/// Encours issu de la série mensuelle de la requête 109.
