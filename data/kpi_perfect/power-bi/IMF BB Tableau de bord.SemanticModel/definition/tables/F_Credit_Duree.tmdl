/// Durée et nombre d'échéances restantes des prêts actifs.
table F_Credit_Duree
	lineageTag: 808fae0d-afbb-4b32-a42b-9d89be5c77ad

	column 'Date situation'
		dataType: dateTime
		lineageTag: dc82ce7b-0718-4aad-b20c-e18037b05c3b
		summarizeBy: none
		sourceColumn: date_situation

	column 'Code agence'
		dataType: string
		lineageTag: c884a8a1-44f3-4a3e-aa40-698c8080d07e
		summarizeBy: none
