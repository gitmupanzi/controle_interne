	column 'Date effet'
		dataType: dateTime
		lineageTag: 9baed82f-0efe-4f6f-9b43-514e7b2a183c
		summarizeBy: none
		sourceColumn: date_effet

	column 'Date fin échéance'
		dataType: dateTime
		lineageTag: d3efdcbf-d40f-421a-92fc-b31e139feef7
