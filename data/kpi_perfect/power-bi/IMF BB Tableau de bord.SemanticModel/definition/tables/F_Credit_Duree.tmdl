	column 'Montant initial'
		dataType: double
		lineageTag: 5a4866a2-bf3b-41b1-8970-0a7582a9b696
		summarizeBy: none
		sourceColumn: montant_initial

	column 'Échéances totales'
		dataType: int64
		lineageTag: 0faa4019-2c4a-43f9-80d6-957662e09d06
		summarizeBy: none
		sourceColumn: nb_echeances_total

	column 'Échéances restantes'
		dataType: int64
		lineageTag: 537300c4-96ab-49bf-add8-4b02b30bf041
