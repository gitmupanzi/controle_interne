/// Portefeuille et PAR par tranche de montant initial.
table F_Credit_Tranches
	lineageTag: 156ca107-d0cd-4dba-8b7f-8d2e10847143

	column 'Date situation'
		dataType: dateTime
		lineageTag: d446aa2b-72eb-43af-8b69-979b4d7d240d
