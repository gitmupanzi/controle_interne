	column 'Taux PAR 1+'
		dataType: double
		lineageTag: a16c5596-120e-40c9-8047-cb06a58e7fb8
		summarizeBy: none
		sourceColumn: par_1_pct

	column 'Taux PAR 30+'
		dataType: double
		lineageTag: fbe428f8-8d17-4ca6-be88-532c2129aca8
		summarizeBy: none
		sourceColumn: par_30_pct

	column 'Taux PAR 90+'
		dataType: double
		lineageTag: 26869c17-c0ed-4d18-b586-4fd941803ec5
		summarizeBy: none
		sourceColumn: par_90_pct

	partition F_Credit_Tranches = m
		mode: import
		source =
				let
					Source = Sql.Database(pServeur, pBaseDonnees, [CreateNavigationProperties=false, CommandTimeout=#duration(0, 0, 10, 0)]),
					SqlTexte = Text.Combine({
					"SET NOCOUNT ON;",
					"DECLARE @date_debut date = '" & Date.ToText(pDateDebut, [Format="yyyy-MM-dd", Culture="en-US"]) & "';",
					"DECLARE @date_fin date = '" & Date.ToText(pDateFin, [Format="yyyy-MM-dd", Culture="en-US"]) & "';",
					"WITH base_clients AS (",
					"select a.ID_CATEGORIE_ADHERENT as code_categorie_client, a.id as id_client, a.code as code_client, a.num_manuel, p.nom as nom_client,",
					"    p.prenoms as prenoms_client, a.id_agence as id_agence, ag.nom as nom_agence, ag.code as code_agence,",
					"case when p.SEXE='SEXE_M' then 'M' when p.SEXE='SEXE_F' then 'F' else '' end as sexe,",
					"case when p.CIVILITE='CIV_M' then 'M' when p.CIVILITE='CIV_MME' then 'Mme' when p.CIVILITE='CIV_MLLE' then 'Mlle' else '' end as civilite,",
					"case when p.STATUT_MATRIMONIAL='ST_MATRI_M' then 'M' when p.STATUT_MATRIMONIAL='ST_MATRI_C' then 'C' when p.STATUT_MATRIMONIAL='ST_MATRI_D' then 'D'  when p.STATUT_MATRIMONIAL='ST_MATRI_V' then 'V' when p.STATUT_MATRIMONIAL='ST_MATRI_S' then 'S' else '' end as statut_matrimonial,",
					"ad.TEL as telephone, a.DATE_INSCRIPTION as date_adhesion, p.DATE_NAISSANCE as date_naissance, p.LIEU_NAISSNACE as lieu_naissance,",
					"py.LIBELLE as nationalite, pidt.CODE as code_type_piece, pidt.LIBELLE as type_piece_identite, pid.NUMERO_PIECE as numero_piece_identite,",
					"ad.EMAIL as email, pr.code as code_profession, pr.libelle as profession,",
					"ad.BP as bp, ad.VILLE as ville, ad.ADRESSE as adresse, ta.ID as code_type_client, ta.LIBELLE as type_client, ca.LIBELLE as categorie_client,",
					"z.CODE as code_zone, z3.CODE as code_zone3, z2.CODE as code_zone2, z1.CODE as code_zone1,",
					"z.LIBELLE as zone, z3.libelle as zone3, z2.libelle as zone2, z1.libelle as zone1,",
					"p.ALPHABETISE as alphabetise, a.DIRIGEANT as dirigeant, i.PERSONNEL as personnel,",
					"gs.NOM +' '+gs.PRENOMS as gestionnaire, case when p.SEXE='SEXE_M' then 1 else 0 end as nbre_homme, case when p.SEXE='SEXE_F' then 1 else 0 end as nbre_femme,",
					"da.DATE_DEPART as date_depart, dad.LIBELLE as motif_depart, DATEDIFF(YEAR, p.DATE_NAISSANCE, a.DATE_INSCRIPTION) as age_adhesion,",
					"a.DATE_LAST_MODIFIED as date_last_modified, a.EST_PERFECT as client_perfect, a.EST_TONTINE as client_tontine,",
					"gsCol.NOM +' '+gsCol.PRENOMS as collecteur, zc.LIBELLE as zone_collecte",
					" from adherents a",
					" left join individus i on a.id=i.id",
					" left join personnes p on i.id_personne=p.id",
					" left join adresses ad on p.ID_ADRESSE=ad.id",
					" left join PROFESSIONS pr on p.ID_PROFESSION=pr.id",
					" left join DEPARTS_ADHERENT da on da.ID_ADHERENT = a.id",
					" left join MOTIFS_DEPART dad on dad.ID = da.ID_MOTIF_DEPART",
					" left join TYPES_ADHERENT ta on ta.id = a.ID_TYPE_ADHERENT",
					" left join CATEGORIES_ADHERENT ca on ca.id = a.ID_CATEGORIE_ADHERENT",
					" left join ZONES z on z.id = a.ID_ZONE",
					" left join ZONES z3 on z3.id = z.ID_ZONE_PARENT",
					" left join ZONES z2 on z2.id = z3.ID_ZONE_PARENT",
					" left join ZONES z1 on z1.id = z2.ID_ZONE_PARENT",
					" left join GESTIONNAIRES g on g.id = a.ID_GESTIONNAIRE",
					" left join PERSONNES gs on gs.id = g.ID_PERSONNE",
					" left join POINTS_SERVICE ag on ag.id = a.ID_AGENCE",
					" left join PAYS py on p.ID_NATIONALITE=py.id",
					" left join PIECES_IDENTITE pid on p.ID_PIECE_IDENTITE=pid.id",
					" left join TYPES_PIECE_IDENTITE pidt on pidt.ID = pid.ID_TYPE_PIECE",
					"left join COLLECTEURS col on col.id = a.ID_COLLECTEUR",
					"left join PERSONNES gsCol on gsCol.id = col.ID_PERSONNE",
					"left join ZONES_COLLECTE zc on zc.id = a.ID_ZONE_COLLECTE",
					"WHERE A.ID_CATEGORIE_ADHERENT = 'IND'",
					"",
					" union",
					"",
					" select a.ID_CATEGORIE_ADHERENT as code_categorie_client, a.id, a.code as code_client, a.NUM_MANUEL, a.nom_adherent as nom_du_client,",
					"null  as prenoms_client, a.id_agence as id_agence, ag.nom as nom_agence, ag.code as code_agence,",
					"case when gpe.TYPE_GRPE='TYPE_GP_M' then 'Masculin' when gpe.TYPE_GRPE='TYPE_GP_F' then 'Feminin'",
					"when gpe.TYPE_GRPE='TYPE_GP_X' then 'Mixte' else '' end as sexe, '' as civilite, '' as statut_matrimonial,",
					"ad.TEL as TELEPHONE, a.DATE_INSCRIPTION as date_adhesion, gpe.DATE_CREATION as date_naissance, gpe.LIEU_RENCONTRE as lieu_naissance,",
					"'' as nationalite, '' as code_type_piece, '' as type_piece_identite, ''  as numero_piece_identite, ad.EMAIL as E_MAIL",
					", s.code as code_profession, s.libelle as profession,",
					"ad.BP as bp, ad.VILLE as ville, ad.ADRESSE as adresse, ta.ID as code_type_client, ta.LIBELLE as type_client, ca.LIBELLE as categorie_client,",
					"z.CODE as code_zone, z3.CODE as code_zone3, z2.CODE as code_zone2, z1.CODE as code_zone1,",
					"z.LIBELLE as zone, z3.libelle as zone3, z2.libelle as zone2, z1.libelle as zone1,",
					"null as alphabetise, a.DIRIGEANT as dirigeant, null as personnel,",
					"gs.NOM +' '+gs.PRENOMS as gestionnaire, gpe.NBRE_HOMME as nbre_homme, gpe.NBRE_FEMME as nbre_femme,",
					"da.DATE_DEPART as date_depart, dad.LIBELLE as motif_depart, DATEDIFF(YEAR, gpe.DATE_CREATION, a.DATE_INSCRIPTION) as age_adhesion,",
					"a.DATE_LAST_MODIFIED as date_last_modified, a.EST_PERFECT as client_perfect, a.EST_TONTINE as client_tontine,",
					"gsCol.NOM +' '+gsCol.PRENOMS as collecteur, zc.LIBELLE as zone_collecte",
					" from adherents a",
					" left join groupes gpe on a.id=gpe.id",
					" left join adresses ad on gpe.ID_ADRESSE=ad.id",
					" left join SECTEURS_ACTIVITE s on s.ID=gpe.ID_SECTEUR",
					" left join DEPARTS_ADHERENT da on da.ID_ADHERENT = a.id",
					" left join MOTIFS_DEPART dad on dad.ID = da.ID_MOTIF_DEPART",
					" left join TYPES_ADHERENT ta on ta.id = a.ID_TYPE_ADHERENT",
					" left join CATEGORIES_ADHERENT ca on ca.id = a.ID_CATEGORIE_ADHERENT",
					" left join ZONES z on z.id = a.ID_ZONE",
					" left join ZONES z3 on z3.id = z.ID_ZONE_PARENT",
					" left join ZONES z2 on z2.id = z3.ID_ZONE_PARENT",
					" left join ZONES z1 on z1.id = z2.ID_ZONE_PARENT",
					" left join GESTIONNAIRES g on g.id = a.ID_GESTIONNAIRE",
					" left join PERSONNES gs on gs.id = g.ID_PERSONNE",
					" left join POINTS_SERVICE ag on ag.id = a.ID_AGENCE",
					"left join COLLECTEURS col on col.id = a.ID_COLLECTEUR",
					"left join PERSONNES gsCol on gsCol.id = col.ID_PERSONNE",
					"left join ZONES_COLLECTE zc on zc.id = a.ID_ZONE_COLLECTE",
					"WHERE A.ID_CATEGORIE_ADHERENT = 'GPE'",
					"",
					"union",
					"",
					"select a.ID_CATEGORIE_ADHERENT as code_categorie_client, a.id, a.code as code_client, a.NUM_MANUEL, a.nom_adherent as nom_du_client,",
					"null  as prenoms_client, a.id_agence as id_agence, ag.nom as nom_agence, ag.code as code_agence,",
					"'' as sexe, '' as civilite, '' as statut_matrimonial,",
					"ad.TEL as TELEPHONE, a.DATE_INSCRIPTION as date_adhesion, en.DATE_CREATION as date_naissance, en.SIEGE_SOCIAL as lieu_naissance,",
					"'' as nationalite, '' as code_type_piece, 'Carte operateur' as type_piece_identite, en.NUM_CARTE_OPERATEUR as numero_piece_identite,",
					"ad.EMAIL as E_MAIL, s.code as code_profession, s.libelle as profession,",
					"ad.BP as bp, ad.VILLE as ville, ad.ADRESSE as adresse, ta.ID as code_type_client, ta.LIBELLE as type_client, ca.LIBELLE as categorie_client,",
					"z.CODE as code_zone, z3.CODE as code_zone3, z2.CODE as code_zone2, z1.CODE as code_zone1,",
					"z.LIBELLE as zone, z3.libelle as zone3, z2.libelle as zone2, z1.libelle as zone1,",
					"null as alphabetise, a.DIRIGEANT as dirigeant, null as personnel,",
					"gs.NOM +' '+gs.PRENOMS as gestionnaire, 0 as nbre_homme, 0 as nbre_femme,",
					"da.DATE_DEPART as date_depart, dad.LIBELLE as motif_depart, DATEDIFF(YEAR, en.DATE_CREATION, a.DATE_INSCRIPTION) as age_adhesion,",
					"a.DATE_LAST_MODIFIED as date_last_modified, a.EST_PERFECT as client_perfect, a.EST_TONTINE as client_tontine,",
					"gsCol.NOM +' '+gsCol.PRENOMS as collecteur, zc.LIBELLE as zone_collecte",
					"from adherents a",
					"left join entreprises en on a.id=en.id",
					"left join adresses ad on en.ID_ADRESSE=ad.id",
					"left join SECTEURS_ACTIVITE s on s.ID=en.ID_SECTEUR_ACTIVITE",
					"left join DEPARTS_ADHERENT da on da.ID_ADHERENT = a.id",
					" left join MOTIFS_DEPART dad on dad.ID = da.ID_MOTIF_DEPART",
					" left join TYPES_ADHERENT ta on ta.id = a.ID_TYPE_ADHERENT",
					" left join CATEGORIES_ADHERENT ca on ca.id = a.ID_CATEGORIE_ADHERENT",
					" left join ZONES z on z.id = a.ID_ZONE",
					" left join ZONES z3 on z3.id = z.ID_ZONE_PARENT",
					" left join ZONES z2 on z2.id = z3.ID_ZONE_PARENT",
					" left join ZONES z1 on z1.id = z2.ID_ZONE_PARENT",
					" left join GESTIONNAIRES g on g.id = a.ID_GESTIONNAIRE",
					" left join PERSONNES gs on gs.id = g.ID_PERSONNE",
					" left join POINTS_SERVICE ag on ag.id = a.ID_AGENCE",
					"left join COLLECTEURS col on col.id = a.ID_COLLECTEUR",
					"left join PERSONNES gsCol on gsCol.id = col.ID_PERSONNE",
					"left join ZONES_COLLECTE zc on zc.id = a.ID_ZONE_COLLECTE",
					"WHERE A.ID_CATEGORIE_ADHERENT = 'SCE'",
					"",
					"union",
					"",
					"select a.ID_CATEGORIE_ADHERENT as code_categorie_client, a.id, a.code as code_client, a.NUM_MANUEL, a.nom_adherent as nom_du_client,",
					"null  as prenoms_client, a.id_agence as id_agence, ag.nom as nom_agence, ag.code as code_agence,",
					"'' as sexe, '' as civilite, '' as statut_matrimonial,",
					"ad.TEL as TELEPHONE, a.DATE_INSCRIPTION as date_adhesion, en.DATE_CREATION as date_naissance, en.SIEGE as lieu_naissance,",
					"'' as nationalite, '' as code_type_piece, 'Num agrement' as type_piece_identite, en.NUM_AGREMENT as numero_piece_identite,",
					"ad.EMAIL as E_MAIL, '' as code_profession, '' as profession,",
					"ad.BP as bp, ad.VILLE as ville, ad.ADRESSE as adresse, ta.ID as code_type_client, ta.LIBELLE as type_client, ca.LIBELLE as categorie_client,",
					"z.CODE as code_zone, z3.CODE as code_zone3, z2.CODE as code_zone2, z1.CODE as code_zone1,",
					"z.LIBELLE as zone, z3.libelle as zone3, z2.libelle as zone2, z1.libelle as zone1,",
					"null as alphabetise, a.DIRIGEANT as dirigeant, null as personnel,",
					"gs.NOM +' '+gs.PRENOMS as gestionnaire, 0 as nbre_homme, 0 as nbre_femme,",
					"da.DATE_DEPART as date_depart, dad.LIBELLE as motif_depart, DATEDIFF(YEAR, en.DATE_CREATION, a.DATE_INSCRIPTION) as age_adhesion,",
					"a.DATE_LAST_MODIFIED as date_last_modified, a.EST_PERFECT as client_perfect, a.EST_TONTINE as client_tontine,",
					"gsCol.NOM +' '+gsCol.PRENOMS as collecteur, zc.LIBELLE as zone_collecte",
					"from adherents a",
					"left join IMFS en on a.id=en.id",
					"left join adresses ad on en.ID_ADRESSE=ad.id",
					"left join DEPARTS_ADHERENT da on da.ID_ADHERENT = a.id",
					" left join MOTIFS_DEPART dad on dad.ID = da.ID_MOTIF_DEPART",
					" left join TYPES_ADHERENT ta on ta.id = a.ID_TYPE_ADHERENT",
					" left join CATEGORIES_ADHERENT ca on ca.id = a.ID_CATEGORIE_ADHERENT",
					" left join ZONES z on z.id = a.ID_ZONE",
					" left join ZONES z3 on z3.id = z.ID_ZONE_PARENT",
					" left join ZONES z2 on z2.id = z3.ID_ZONE_PARENT",
					" left join ZONES z1 on z1.id = z2.ID_ZONE_PARENT",
					" left join GESTIONNAIRES g on g.id = a.ID_GESTIONNAIRE",
					" left join PERSONNES gs on gs.id = g.ID_PERSONNE",
					" left join POINTS_SERVICE ag on ag.id = a.ID_AGENCE",
					"left join COLLECTEURS col on col.id = a.ID_COLLECTEUR",
					"left join PERSONNES gsCol on gsCol.id = col.ID_PERSONNE",
					"left join ZONES_COLLECTE zc on zc.id = a.ID_ZONE_COLLECTE",
					"WHERE A.ID_CATEGORIE_ADHERENT = 'IMF'",
					"),",
					"base_credits AS (",
					"SELECT",
					"a.*,",
					"C.ID as id_pret, c.ID_DOSSIER_CREDIT as id_dossier, ca.ID_DEMANDE,",
					"CY.ID as id_cycle_pret,",
					"C.NUMERO_PRET as numero_pret,",
					"C.NUMERO_CONTRAT as numero_contrat,",
					"C.ID_COMPTE_CREDIT as id_compte_credit,",
					"cpteC.NUM_CPTE as num_compte_credit,",
					"C.ID_COMPTE_SAIN as id_compte_sain,",
					"cpteS.NUM_CPTE as num_compte_sain,",
					"ae.NOM + ' ' + ae.PRENOMS as gestionnaire_pret,",
					"ca.NUM_DOSSIER as numero_dossier,",
					"dd.REF_DEMANDE as reference_demande,",
					"dd.NUM_DEMANDE as numero_demande,",
					"dd.DATE_RECEPTION as date_demande,",
					"dd.ID_AGENCE as id_agence_demande,",
					"xx.NOM as nom_agence_demande,  xx.code as code_agence_demande,",
					"dd.NBRE_BENEFICIAIRE as NBRE_BENEFICIAIRE,",
					"d.SYMBOLE as devise,",
					"d.id as id_devise,",
					"d.code as code_devise, d.arrondi AS arrondi, C.TYPE_DUREE_CREDIT as terme_credit,",
					"ca.NBRE_ECHEANCE as nb_echeance, ca.TAUX_ANNUEL as taux, ca.ID_PERIODICITE, tt.CLE_LIBELLE as periodicite,",
					"CY.MONTANT as mtt_pret, c.DATE_EFFET as date_effet, cy.FIN_ECHEANCE as date_fin_echeance, cy.NUM_CYCLE as numero_cycle,",
					"aq.NOM + ' ' + aq.PRENOMS as superviseur, dd.ID_PRODUIT_CREDIT as id_produit, w.LIBELLE as produit, ca.ID_PRDT_CRD_TRANCHE as id_produit_tranche, ca.ID_OBJET_FIN as id_objet_fin,",
					"ob.LIBELLE as objet_fin, sc.LIBELLE as secteur_activite, sf.id as id_source_fin, sf.NOM_SOURCE_FIN as source_fin,",
					"case when sf.TYPE = 'SRC_AFF' then 'A' else 'O' end as type_source_fin,",
					"c.teg, c.date_perte, C.date_solde, C.DATE_REECH, CY.DATE_DEBUT as date_debut_cycle, CY.DATE_CLOTURE as date_cloture_cycle,",
					"c.date_decaissement, (select min(date_echeance) from TABAMOR tb where tb.id_cycle_pret = CY.ID) as date_premiere_echeance",
					"",
					"",
					"from CYCLES_PRET CY",
					"inner join PRETS C on CY.ID_PRET = C.ID",
					"inner join DEVISES d on c.ID_DEVISE = d.id",
					"inner join DOSSIERS_CREDIT ca on ca.id = c.ID_DOSSIER_CREDIT",
					"left join PERIODICITES tt on tt.id = ca.ID_PERIODICITE",
					"left join GESTIONNAIRES g on g.id = ca.ID_GESTIONNAIRE",
					"left join PERSONNES ae on ae.id = g.ID_PERSONNE",
					"inner join DEMANDES_CREDIT dd on dd.id = ca.ID_DEMANDE",
					"left join base_clients a on a.id_client = dd.ID_ADHERENT",
					"left join SUPERVISEUR g2 on g2.id = g.ID_SUPERVISEUR",
					"left join PERSONNES aq on aq.id = g2.ID_PERSONNE",
					"left join PRODUITS_CRD w on w.id = dd.ID_PRODUIT_CREDIT",
					"left join OBJETS_FIN ob on ob.id = ca.ID_OBJET_FIN",
					"left join SECTEURS_ACTIVITE_CREDIT sc on sc.id = ob.ID_SECTEUR",
					"left join SOURCES_FIN sf on sf.id = c.ID_SOURCE_FIN",
					"left join POINTS_SERVICE xx on xx.id = dd.ID_AGENCE",
					"left join COMPTES cpteC on cpteC.id = C.ID_COMPTE_CREDIT",
					"left join COMPTES cpteS on cpteS.id = C.ID_COMPTE_SAIN",
					"",
					"where a.client_perfect = 1",
					"),",
					"encours_pret AS (",
					"  SELECT",
					"    oc.ID_PRET AS ID_PRET,",
					"    SUM(CASE WHEN oc.SENS_OPERATION = 'D' THEN 1 ELSE -1 END * ISNULL(oc.MONTANT, 0)) AS mtt_encours",
					"  FROM dbo.OPERATIONS_CRD AS oc",
					"  INNER JOIN dbo.OPERATIONS AS o",
					"    ON o.ID = oc.ID_OPERATION",
					"  WHERE",
					"    o.DATE_OPERATION <= @date_fin",
					"    AND ISNULL(o.ANNULE, 0) = 0",
					"    AND (",
					"      oc.ID_TYPE_OPERATION IN ('DCSM', 'REMB', 'RECR') OR o.ID_TYPE_OPERATION = 'CONS'",
					"    )",
					"  GROUP BY",
					"    oc.ID_PRET",
					"), remboursements_echeance AS (",
					"  SELECT",
					"    r.ID_TABAMORT AS ID_TABAMORT,",
					"    SUM(",
					"      ISNULL(r.CAPITAL, 0) + ISNULL(r.INTERET, 0) + ISNULL(r.COMMISSION, 0) + ISNULL(r.EPARGNE, 0)",
					"    ) AS total_rembourse",
					"  FROM dbo.REMBOURS_CRD AS r",
					"  INNER JOIN dbo.OPERATIONS_CRD AS oc",
					"    ON oc.ID = r.ID_OPERATION_CRD",
					"  INNER JOIN dbo.OPERATIONS AS o",
					"    ON o.ID = oc.ID_OPERATION",
					"  WHERE",
					"    o.DATE_OPERATION <= @date_fin AND ISNULL(o.ANNULE, 0) = 0",
					"  GROUP BY",
					"    r.ID_TABAMORT",
					"), retard_pret AS (",
					"  SELECT",
					"    cp.ID_PRET AS ID_PRET,",
					"    MAX(",
					"      CASE",
					"        WHEN ISNULL(t.CAPITAL, 0) + ISNULL(t.INTERET, 0) + ISNULL(t.COMMISSION, 0) + ISNULL(t.EPARGNE, 0) - ISNULL(re.total_rembourse, 0) > 0.01",
					"        THEN DATEDIFF(DAY, CAST(t.DATE_ECHEANCE AS DATETIME2), CAST(@date_fin AS DATETIME2))",
					"        ELSE 0",
					"      END",
					"    ) AS jours_retard",
					"  FROM dbo.CYCLES_PRET AS cp",
					"  INNER JOIN dbo.TABAMOR AS t",
					"    ON t.ID_CYCLE_PRET = cp.ID",
					"  LEFT JOIN remboursements_echeance AS re",
					"    ON re.ID_TABAMORT = t.ID",
					"  WHERE",
					"    t.DATE_ECHEANCE < @date_fin",
					"  GROUP BY",
					"    cp.ID_PRET",
					"), base AS (",
					"  SELECT",
					"    ecv.code_agence_demande AS code_agence_demande,",
					"    ecv.nom_agence_demande AS nom_agence_demande,",
					"    ecv.id_produit AS id_produit,",
					"    ecv.produit AS produit,",
					"    ecv.code_devise AS code_devise,",
					"    ecv.id_pret AS id_pret,",
					"    ecv.id_client AS id_client,",
					"    ISNULL(ecv.mtt_pret, 0) AS montant_initial,",
					"    ISNULL(ep.mtt_encours, 0) AS mtt_encours,",
					"    ISNULL(rp.jours_retard, 0) AS jours_retard,",
					"    CASE",
					"      WHEN ISNULL(ecv.mtt_pret, 0) < 10000",
					"      THEN 'Moins de 10K'",
					"      WHEN ISNULL(ecv.mtt_pret, 0) < 15000",
					"      THEN '10K a 15K'",
					"      WHEN ISNULL(ecv.mtt_pret, 0) < 30000",
					"      THEN '15K a 30K'",
					"      WHEN ISNULL(ecv.mtt_pret, 0) < 50000",
					"      THEN '30K a 50K'",
					"      ELSE '50K et plus'",
					"    END AS tranche_montant_initial",
					"  FROM base_credits AS ecv",
					"  LEFT JOIN encours_pret AS ep",
					"    ON ep.ID_PRET = ecv.id_pret",
					"  LEFT JOIN retard_pret AS rp",
					"    ON rp.ID_PRET = ecv.id_pret",
					"  WHERE",
					"    ecv.date_effet <= @date_fin",
					"    AND (",
					"      ecv.date_solde IS NULL OR ecv.date_solde > @date_fin",
					"    )",
					"    AND (",
					"      ecv.date_perte IS NULL OR ecv.date_perte > @date_fin",
					"    )",
					"    AND (",
					"      ecv.date_cloture_cycle IS NULL OR ecv.date_cloture_cycle > @date_fin",
					"    )",
					"    AND ecv.date_debut_cycle <= @date_fin",
					"    AND ISNULL(ep.mtt_encours, 0) > 0",
					")",
					"SELECT",
					"  @date_fin AS date_situation,",
					"  code_agence_demande,",
					"  nom_agence_demande,",
					"  produit,",
					"  code_devise,",
					"  tranche_montant_initial,",
					"  COUNT(DISTINCT id_client) AS nb_clients,",
					"  COUNT(DISTINCT id_pret) AS nb_prets,",
					"  SUM(montant_initial) AS montant_initial_total,",
					"  SUM(mtt_encours) AS encours_total,",
					"  SUM(CASE WHEN jours_retard > 0 THEN mtt_encours ELSE 0 END) AS par_1_plus,",
					"  SUM(CASE WHEN jours_retard > 30 THEN mtt_encours ELSE 0 END) AS par_30_plus,",
					"  SUM(CASE WHEN jours_retard > 90 THEN mtt_encours ELSE 0 END) AS par_90_plus,",
					"  CASE",
					"    WHEN SUM(mtt_encours) = 0",
					"    THEN 0",
					"    ELSE ROUND(",
					"      100.0 * SUM(CASE WHEN jours_retard > 0 THEN mtt_encours ELSE 0 END) / SUM(mtt_encours),",
					"      2",
					"    )",
					"  END AS par_1_pct,",
					"  CASE",
					"    WHEN SUM(mtt_encours) = 0",
					"    THEN 0",
					"    ELSE ROUND(",
					"      100.0 * SUM(CASE WHEN jours_retard > 30 THEN mtt_encours ELSE 0 END) / SUM(mtt_encours),",
					"      2",
					"    )",
					"  END AS par_30_pct,",
					"  CASE",
					"    WHEN SUM(mtt_encours) = 0",
					"    THEN 0",
					"    ELSE ROUND(",
					"      100.0 * SUM(CASE WHEN jours_retard > 90 THEN mtt_encours ELSE 0 END) / SUM(mtt_encours),",
					"      2",
					"    )",
					"  END AS par_90_pct",
					"FROM base",
					"GROUP BY",
					"  code_agence_demande,",
					"  nom_agence_demande,",
					"  id_produit,",
					"  produit,",
					"  code_devise,",
					"  tranche_montant_initial",
					"ORDER BY",
					"  code_devise,",
					"  nom_agence_demande,",
					"  produit,",
					"  CASE tranche_montant_initial",
					"    WHEN 'Moins de 10K'",
					"    THEN 1",
					"    WHEN '10K a 15K'",
					"    THEN 2",
					"    WHEN '15K a 30K'",
					"    THEN 3",
					"    WHEN '30K a 50K'",
					"    THEN 4",
					"    ELSE 5",
					"  END;"
					}, "#(lf)"),
					Resultat = Value.NativeQuery(Source, SqlTexte, null, [EnableFolding=false])
				in
					Resultat

	annotation RequetePerfectVision = 104

	annotation SourceLocale = BB_VISION_PRO_TEST

