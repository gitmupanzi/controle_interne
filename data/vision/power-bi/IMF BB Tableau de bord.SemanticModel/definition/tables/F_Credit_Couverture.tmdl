/// Couverture des arriérés et du principal par épargne, cautions et garanties.
table F_Credit_Couverture
	lineageTag: 9144252c-823b-4ab5-8fec-7d976873cdc1

	column 'Date situation'
		dataType: dateTime
		lineageTag: 100db3d3-c89a-437f-870f-f79a97b29e83
		summarizeBy: none
