/// Principaux encours de crédit par client et prêt à la date de situation.
table F_Credit_Top_Encours
	lineageTag: ece7cddf-672e-4738-97aa-add9121cec63

	column 'Date situation'
		dataType: dateTime
		lineageTag: 25df6a9a-afe9-4457-9441-83dbb61a6c90
		summarizeBy: none
		sourceColumn: date_situation

	column 'Code agence'
		dataType: string
		lineageTag: e93fcc62-bb3e-4729-a6f2-e1860c3e7818
		summarizeBy: none
		sourceColumn: code_agence_demande

	column Agence
		dataType: string
		lineageTag: f77f0a28-a92c-4add-890d-14fedc75775d
		summarizeBy: none
		sourceColumn: nom_agence_demande

	column 'Produit crédit'
		dataType: string
		lineageTag: 01b205e0-eeff-4462-ac58-43420a644caa
		summarizeBy: none
		sourceColumn: produit

	column Devise
		dataType: string
		lineageTag: bab524ea-9ddf-4a8a-88df-fe84b1703fea
